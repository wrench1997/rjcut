# ================== 数据库和 Redis（主机端口，用于本地测试或外部工具） ==================
DATABASE_URL=postgresql://rjcut:rjcut_secret_2024@localhost:5433/rjcut
REDIS_URL=redis://localhost:6380/0

# ================== MinIO 配置 ==================
# 容器内部通信用（api、worker 等 Docker 服务连接 MinIO 时使用）
MINIO_ENDPOINT=192.168.166.151:9003

# 访问密钥（保持不变）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rjcut
MINIO_USE_SSL=false

# 外部访问地址（用于生成 presigned URL，让浏览器或外部用户能访问文件）
MINIO_EXTERNAL_ENDPOINT=http://192.168.166.151:9003

# 其他配置
TASK_TIMEOUT_SECONDS=3600
TASK_STALE_CHECK_INTERVAL=60
SECRET_KEY=change_me_in_production_2024
RQ_QUEUE_NAME=rjcut_tasks



FILE_STORAGE_DAYS=15              # 文件保留天数，默认 15 天
FILE_MAX_SIZE_MB=500              # 单文件最大大小 (MB)，默认 500MB
FILE_ENABLE_DEDUPLICATION=true    # 是否启用 hash 去重，默认 true

# ================== AI Gateway 配置 ==================
# Docker 容器内使用：http://gateway:8888
# 本地开发使用：http://localhost:8888 或 http://192.168.166.151:8888
GATEWAY_BASE_URL=http://localhost:8888
