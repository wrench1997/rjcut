# ===========================================
# RJCut Studio 环境变量配置示例
# ===========================================
# 复制此文件为 .env.local 并根据需要修改

# ===========================================
# VFS (虚拟文件系统) 配置
# ===========================================

# VFS 模式：LOCAL_SERVER | EXTENSION | LOCAL_VFS
# - LOCAL_SERVER: 连接本地 VFS 服务器（推荐，脱离浏览器限制）
# - EXTENSION: 通过 Chrome 扩展访问 IndexedDB VFS
# - LOCAL_VFS: 直接使用浏览器内 IndexedDB VFS（降级模式）
NEXT_PUBLIC_VFS_MODE=LOCAL_SERVER

# 本地 VFS 服务器 WebSocket 地址
NEXT_PUBLIC_LOCAL_VFS_URL=ws://localhost:8765/mcp

# Chrome 扩展 ID（如果使用 EXTENSION 模式）
NEXT_PUBLIC_EXTENSION_ID=YOUR_EXTENSION_ID_HERE

# ===========================================
# 本地 VFS 服务器配置 (local-vfs-server)
# ===========================================

# VFS 服务端口（默认 8765）
VFS_PORT=8765

# 允许的根目录（逗号分隔）
# Windows 示例：D:\workspace\rjcut\studio,D:\Videos\RJCut
# Linux/Mac 示例：/home/user/rjcut,/home/user/Videos
VFS_ROOTS=./,~/Videos/RJCut

# 允许删除操作（默认 true）
VFS_ALLOW_DELETE=true

# 允许写入操作（默认 true）
VFS_ALLOW_WRITE=true

# 记录操作日志（默认 true）
VFS_LOG=true

# 最大文件大小（字节，默认 100MB）
VFS_MAX_FILE_SIZE=104857600

# ===========================================
# MCP Bridge Server 配置
# ===========================================

# Bridge Server WebSocket 端口（Codex 连接）
BRIDGE_WS_PORT=8766

# Bridge Server HTTP 轮询端口（扩展连接）
BRIDGE_HTTP_PORT=8767

# Chrome 扩展 ID
EXTENSION_ID=YOUR_EXTENSION_ID_HERE

# ===========================================
# 开发配置
# ===========================================

# Next.js 开发服务器端口
PORT=3000